# Copy to .env and adjust values for local development

# Application
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/myapp
DATABASE_USERNAME=myapp
DATABASE_PASSWORD=myapp
DB_HIKARI_MAX_POOL_SIZE=10
DB_HIKARI_MIN_IDLE=2

# Redis
REDIS_URL=redis://localhost:6379
REDIS_POOL_MAX_ACTIVE=8
REDIS_SSL_ENABLED=false

# Security
SECURITY_JWT_SECRET=change-me-in-production-use-a-long-random-secret-key-at-least-32-chars
SECURITY_JWT_EXPIRATION=3600000
SECURITY_JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Server
SERVER_CONNECTION_TIMEOUT=30s
SERVER_TOMCAT_THREADS_MAX=200

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# Logging
LOGGING_REQUESTS_ENABLED=false

# OAuth2 (optional — leave blank to disable)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
